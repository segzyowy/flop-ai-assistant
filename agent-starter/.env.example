FLOP_AGENT_DID=did:key:z6MkooHatvhcHQjgQ62MyUoLe1TwNQoWvyjKPLNL3ysDDW5h
AGENT_NAME=FLOP Local Agent
AGENT_STORAGE=./data

# Local Ollama is free to use. Set AI_PROVIDER=flop to use FLOP DevNet instead.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
