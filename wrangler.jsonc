{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flop-ai-assistant",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "FLOP_MODEL_ID": "qwen/qwen2.5-0.5b-instruct"
  }
}
